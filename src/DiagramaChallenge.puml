@startuml
skinparam classAttributeIconSize 0
hide empty members

package com-amazul-fiap-api_springboot-model {

  class Artigo {
    - Long id
    - String titulo
    - String resumo
    - String corpo
    + void setStatus(StatusArtigo)
  }

  class Fonte {
    - Long id
    - String titulo
    - String url
    - LocalDate dataConsulta
  }

  class Local {
    - Long id
    - String nome
    - String cidade
    - String nomePais
    - String codigoPais
    - Double latitude
    - Double longitude
  }

  class ArtigoFonte {
    - Long id
    - String observacao
  }

  enum StatusArtigo {
    RASCUNHO
    PUBLICADO
    ARQUIVADO
  }

  enum AreaAplicacao {
    ENERGIA
    SAUDE
    AGRICULTURA
    INDUSTRIA
    PESQUISA
  }

  ' Relacionamentos
  Artigo "*" --> "0..1" Local : local
  Artigo "1" <-- "0..*" ArtigoFonte : artigo
  Artigo "1" --> "0..*" ArtigoFonte : referencias
  Fonte "1" <-- "0..*" ArtigoFonte : fonte
  Fonte "1" --> "0..*" ArtigoFonte : artigos

  Artigo --> AreaAplicacao : areaAplicacao
  Artigo --> StatusArtigo : status

}
@enduml