@startuml
skinparam classAttributeIconSize 0
hide empty members

package com.amazul.fiap.api_springboot.model {

  class Artigo {
    - Long id
    - AreaAplicacao areaAplicacao
    - String titulo
    - String resumo
    - String aplicacaoReal
    - String impactoSociedade
    - Local local
    - StatusArtigo status
    - List<ArtigoFonte> referencias
    - Date atualizadoEm
    + void setStatus(StatusArtigo status)
  }

  class Fonte {
    - Long id
    - String titulo
    - String url
    - List<ArtigoFonte> artigos
    - LocalDate dataConsulta
    - Date atualizadoEm
  }

  class Local {
    - Long id
    - String nome
    - Pais pais
  }

  class Pais {
    - Long id
    - String nome
    - String codigoPais
    - String latitude
    - String longitude
  }

  class ArtigoFonte {
    - Long id
    - Artigo artigo
    - Fonte fonte
    - String observacao
  }

  enum StatusArtigo {
    RASCUNHO
    PUBLICADO
    ARQUIVADO
  }

  enum AreaAplicacao {
    ENERGIA
    SAUDE
    AGRICULTURA
    INDUSTRIA
    PESQUISA
  }

  ' Relacionamentos Geográficos (Normalização 3FN / BCNF)
  Artigo "*" --> "0..1" Local : local
  Local "*" --> "0..1" Pais : pais

  ' Composição devido ao cascade ALL + orphanRemoval em Artigo -> ArtigoFonte
  Artigo "1" *-- "0..*" ArtigoFonte : referencias
  ArtigoFonte "0..*" --> "1" Artigo : artigo

  Fonte "1" <-- "0..*" ArtigoFonte : fonte
  Fonte "1" --> "0..*" ArtigoFonte : artigos

  Artigo --> AreaAplicacao : areaAplicacao
  Artigo --> StatusArtigo : status

}
@enduml
