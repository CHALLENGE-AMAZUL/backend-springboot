@startuml
skinparam classAttributeIconSize 0
hide empty members

package com-amazul-fiap-api-springboot-model {

  class Artigo {
    - Long id
    - String titulo
    - String resumo
    - String aplicacaoReal
    - String impactoSociedade
    - Date atualizadoEm
  }

  class Fonte {
    - Long id
    - String titulo
    - String url
    - LocalDate dataConsulta
    - Date atualizadoEm
  }

  class Local {
    - Long id
    - String nome
    - String nomePais
    - String codigoPais
    - String latitude
    - String longitude
  }

  class ArtigoFonte {
    - Long id
    - String observacao
  }

  enum StatusArtigo {
    RASCUNHO
    PUBLICADO
    ARQUIVADO
  }

  enum AreaAplicacao {
    ENERGIA
    SAUDE
    AGRICULTURA
    INDUSTRIA
    PESQUISA
  }

  ' Relacionamentos
  Artigo "*" --> "0..1" Local : local

  ' Composição devido ao cascade ALL + orphanRemoval em Artigo -> ArtigoFonte
  Artigo "1" *-- "0..*" ArtigoFonte : referencias
  ArtigoFonte "0..*" --> "1" Artigo : artigo

  Fonte "1" <-- "0..*" ArtigoFonte : fonte
  Fonte "1" --> "0..*" ArtigoFonte : artigos

  Artigo --> AreaAplicacao : areaAplicacao
  Artigo --> StatusArtigo : status

}
@enduml